{
  "name": "mqttpulse",
  "version": "1.0.0",
  "description": "Real-time MQTT 5.0 and 3.1.1 topic tree visualizer, payload decoder, and IoT device fleet chaos simulator.",
  "type": "module",
  "bin": {
    "mqttpulse": "./bin/mqttpulse.js"
  },
  "main": "dist/server/index.js",
  "scripts": {
    "build:web": "npm --prefix web run build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "dev:server": "tsx watch src/cli.ts --embedded-broker --port 4100",
    "dev:web": "npm --prefix web run dev",
    "dev": "tsx src/cli.ts --dev",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mqtt",
    "mqtt-5",
    "iot",
    "telemetry",
    "observability",
    "trie",
    "d3js",
    "protobuf",
    "cbor",
    "msgpack",
    "chaos-engineering",
    "packet-inspector",
    "typescript",
    "react19"
  ],
  "author": "Alexandr Motologa",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "@msgpack/msgpack": "^3.1.2",
    "aedes": "^0.51.3",
    "cbor-x": "^1.6.0",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "mqtt": "^5.10.4",
    "picocolors": "^1.1.1",
    "protobufjs": "^7.4.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "puppeteer": "^25.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
